{
  "include": [
    "src/**/*.{js,ts,mjs,mts}",
    "tests/mocks/**/*.{js,ts,mjs,mts}"
  ],
  "exclude": [
    "**/*.d.ts",
    "tests/**/*.{test,spec}.{js,ts,mjs,mts}",
    "cli/**/*",
    "dist",
    "node_modules",
    ".idea",
    "coverage",
    ".git",
    ".github",
    ".vscode",
    "venv"
  ],
  "reporter": [
    "text",
    "lcov",
    "json"
  ],
  "all": true,
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80,
  "temp-directory": "./coverage/tmp",
  "clean": true,
  "extension": [
    ".ts",
    ".js",
    ".mjs",
    ".mts"
  ],
  "merge-async": true
}