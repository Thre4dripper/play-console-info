{
  "include": ["src/**/*.{js,ts,mjs,mts}", "cli/mock/mockCli.js"],
  "exclude": [
    "src/types.ts",
    "**/*.d.ts",
    "tests/**/*.{test,spec}.{js,ts,mjs,mts}",
    "cli/python/**/*",
    "cli/mock/build-mock-cli-*.sh",
    "cli/mock/build-mock-cli-*.bat",
    "dist",
    "node_modules",
    ".idea",
    "coverage",
    ".git",
    ".github",
    ".vscode",
    "venv"
  ],
  "reporter": ["text", "lcov", "json"],
  "all": true,
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80,
  "temp-directory": "./coverage/tmp",
  "clean": true,
  "extension": [".ts", ".js", ".mjs", ".mts"],
  "merge-async": true
}
