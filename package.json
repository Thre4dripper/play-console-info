{
  "name": "play-console-info",
  "version": "1.0.0",
  "description": "A Github Action to get play console info",
  "author": "Ijlal Ahmad",
  "main": "index.js",
  "private": true,
  "keywords": [
    "play",
    "console",
    "info",
    "actions",
    "github"
  ],
  "exports": {
    ".": {
      "dist": "./dist/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js",
    "build-cli": "PyInstaller -F cli/play_console_cli.py --distpath cli/dist --workpath cli/build --specpath cli --name play_console_cli",
    "virtual-env-windows": "python -m venv venv && .\\venv\\Scripts\\activate && pip install -r cli/requirements.txt",
    "virtual-env-linux": "python3 -m venv venv && . venv/bin/activate && pip install -r cli/requirements.txt",
    "build-cli-windows": "npm run virtual-env-windows && .\\venv\\Scripts\\activate &&  npm run build-cli",
    "build-cli-linux": "npm run virtual-env-linux && . venv/bin/activate && npm run build-cli",
    "cli-cleanup": "rimraf cli\\build cli\\dist cli\\play_console_cli.spec",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'npm run build && node dist/index.js'",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint src --ext .ts",
    "local-action": "npx @github/local-action . src/main.ts .env"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.2.0",
    "@github/local-action": "^5.1.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "rimraf": "^6.0.1",
    "tsc": "^2.0.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
